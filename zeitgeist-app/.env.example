# Also supplies optional related news when MARKET_DATA_PROVIDER=dsa.
POLYGON_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_CHAT_MODEL=claude-sonnet-5-5
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: required for trusted snapshots, generation cache and chat persistence.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side provider selection; restart Next.js after changing.
MARKET_DATA_PROVIDER=polygon
# The internal bridge also provides optional quarterly income, balance-sheet and cash-flow statements.
DSA_BASE_URL=http://127.0.0.1:8001
DSA_SERVICE_TOKEN=

# Optional absolute Python executable for npm run dev:all / start:all.
DSA_PYTHON=
